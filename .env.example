# Copy to `.env.local` for local development. Both values are optional:
# without VITE_WEB3FORMS_KEY the contact form simulates a successful submission,
# without VITE_HCAPTCHA_SITEKEY the captcha is not rendered.
# In production they come from the repository's GitHub Actions secrets.
VITE_WEB3FORMS_KEY=
VITE_HCAPTCHA_SITEKEY=
