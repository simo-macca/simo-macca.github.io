{
  "name": "simo-macca.github.io",
  "version": "2.0.0",
  "description": "Personal portfolio of Simone Maccario, built with Vue 3, Tailwind CSS v4 and Vite.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . -D correctness --ignore-path .gitignore && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "run-s lint:check format:check build",
    "prepare": "husky"
  },
  "dependencies": {
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@lucide/vue": "^1.70.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "@vueuse/motion": "^3.0.3",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-oxc": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "~1.92.0",
    "eslint-plugin-vue": "~10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.92.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "oxlint --fix -D correctness --ignore-path .gitignore",
      "eslint --fix --cache"
    ],
    "*.{js,vue,css,html,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
